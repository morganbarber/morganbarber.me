# dependencies
node_modules
.pnp
.pnp.*

# build output
.next
out
dist
build
*.tsbuildinfo

# turborepo
.turbo

# Compiled output that must never sit next to sources. The packages are
# consumed as TypeScript via transpilePackages; committed .js/.d.ts files there
# go stale and shadow the real sources.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.js.map

# environment — secrets live here and must never be committed
.env
.env.*
# Templates are committed. The negation has to match `.env.sst.example` too,
# which `!.env.example` alone does not.
!.env*.example

# credentials and keys of any kind
*.pem
*.key
*.p12
*.pfx
*.keystore
service-account*.json
*-credentials.json

# testing
coverage
.nyc_output

# deployment
.vercel

# SST — local state holds resolved values for every managed variable
.sst
.env.sst
# SST writes one into every workspace to type `Resource` links. Nothing in this
# repo uses Resource, and SST regenerates them on every deploy.
sst-env.d.ts

# editors / OS
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Original certificate PDFs (unredacted: contain the CompTIA candidate ID).
# Redacted copies are published from apps/portfolio/public/certifications.
certs/
