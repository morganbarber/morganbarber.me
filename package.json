{
    "name": "portfolio-monorepo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "turbo dev --filter=portfolio-web",
        "build": "turbo build --filter=portfolio-web",
        "lint": "turbo lint",
        "type-check": "turbo type-check",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
        "check:supabase": "npm run check:supabase --workspace portfolio-web",
        "check:headers": "npm run check:headers --workspace portfolio-web",
        "audit:security": "npm audit --audit-level=high",
        "verify": "npm run type-check && npm run lint && npm run test && npm run audit:security",
        "clean": "rm -rf node_modules .turbo apps/*/.next apps/*/.turbo packages/*/.turbo packages/*/dist",
        "dev:admin": "turbo dev --filter=@repo/admin",
        "dev:all": "turbo dev",
        "build:all": "turbo build",
        "sst:install": "sst install",
        "deploy": "sst deploy --stage production",
        "deploy:preview": "sst deploy --stage preview",
        "sst:remove": "sst remove",
        "admin:hash-password": "npm run admin:hash-password --workspace @repo/admin",
        "test": "turbo test"
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "sst": "^4.17.1",
        "turbo": "^2.3.3"
    },
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "next": "^16.3.5",
        "sharp": "^0.35.5",
        "postcss": "^8.5.23"
    }
}
