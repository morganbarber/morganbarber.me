# =============================================================================
# Deploy-time configuration for `sst deploy`
# =============================================================================
# Copy to .env.sst (gitignored) and fill in. SST reads .env and .env.<stage>;
# anything already exported in the shell takes precedence.
#
#   cp .env.sst.example .env.sst
#   npx sst deploy --stage production
#
# These values are pushed to Vercel as project environment variables. They are
# NOT baked into the repository and never appear in the uploaded source —
# .vercelignore excludes every .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Vercel credentials (required)
# -----------------------------------------------------------------------------
# https://vercel.com/account/tokens — scope it to the single project once it
# exists. The Pulumi provider reads this from the environment.
VERCEL_API_TOKEN=

# Team slug or ID. Omit for a personal account.
# VERCEL_TEAM=

# Custom domain, applied on the production stage only. The apex/www counterpart
# is redirected to it with a 308 so the site has one canonical host.
# VERCEL_DOMAIN=morganbarber.me

# Deployment region for the server functions. Pages render per request (nonce
# CSP), so put them near Supabase rather than near the visitor.
# VERCEL_FUNCTION_REGION=iad1

# -----------------------------------------------------------------------------
# Application configuration (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=https://morganbarber.me

# -----------------------------------------------------------------------------
# Secrets (ANALYTICS_SALT required for production)
# -----------------------------------------------------------------------------
# Both are stored on Vercel as `sensitive`, meaning they cannot be read back
# through the dashboard or API once written.
#
#   openssl rand -base64 48
ANALYTICS_SALT=
REVALIDATE_SECRET=
