# =============================================================================
# Admin dashboard — environment template
# =============================================================================
# Copy to .env.local. This file holds the service-role key: never commit
# .env.local, and never deploy this app.
#
#   cp .env.example .env.local
#   npm run dev --workspace @repo/admin     # http://127.0.0.1:3100
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Same project as the portfolio.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# The service-role / secret key. BYPASSES ALL ROW-LEVEL SECURITY.
#
# Required, because the dashboard edits tables the publishable key cannot touch
# and must see unpublished drafts. Note the absence of a NEXT_PUBLIC_ prefix:
# that is what keeps it out of the browser bundle, and the app refuses to start
# if a publishable key is pasted here instead.
#
#   Supabase dashboard → Project Settings → API Keys → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Access (required)
# -----------------------------------------------------------------------------
# PREFERRED: a scrypt hash of the password rather than the password itself.
# NIST SP 800-63B §5.1.1.2 asks for a salted, memory-hard stored verifier —
# a plaintext password in a dotfile survives in backups, editor swap files and
# shell history, and anyone who can read the file has the credential.
#
#   npm run admin:hash-password          # generates a password AND its hash
#   npm run admin:hash-password -- "pw"  # hashes one you already chose
#
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>

# FALLBACK: plaintext password, minimum 8 characters. Still supported, but the
# app warns on startup. Set this OR ADMIN_PASSWORD_HASH, not both.
#
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Optional. Signs session cookies. Defaults to a value derived from
# ADMIN_PASSWORD, which means changing the password ends existing sessions.
#
#   openssl rand -base64 48
# ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Live-refresh of the public site (optional but recommended)
# -----------------------------------------------------------------------------
# The portfolio caches content for an hour. With these set, saving here purges
# that cache immediately so edits appear at once. Without them, saves still
# work — the site just takes up to an hour to catch up.
#
# REVALIDATE_SECRET must be the SAME value as in apps/portfolio/.env.local.
PORTFOLIO_URL=http://localhost:3000
REVALIDATE_SECRET=
