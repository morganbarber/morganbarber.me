# =============================================================================
# morganbarber.me — environment template
# =============================================================================
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: it is the only place secrets live.
#
#   cp .env.example .env.local
#   npm run check:supabase     # verifies everything below is actually working
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Dashboard -> Project Settings -> API
#
# No trailing slash. Both values are embedded in the client bundle, which is
# expected: the publishable key is public by design and carries no authority
# beyond what the RLS policies in supabase/schema.sql allow.
#
# NEVER put a service_role or sb_secret_ key here. The app does not need one —
# every privileged operation goes through a SECURITY DEFINER function instead —
# and `npm run check:supabase` will fail loudly if one is found.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy alternative. Supabase renamed this key when it moved off JWTs; both
# names are read, with PUBLISHABLE taking precedence. Set one, not both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Site identity (optional)
# -----------------------------------------------------------------------------
# Canonical origin, used for metadata, the sitemap, canonical URLs and the
# same-origin check on POST /api/analytics. Defaults to https://morganbarber.me.
# Set this in preview environments so canonical links do not point at production.

# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Analytics salt (recommended)
# -----------------------------------------------------------------------------
# Salts the SHA-256 of each visitor's IP address. Raw addresses are never
# stored. Without a salt the hash would be reversible by brute force — the whole
# IPv4 space hashes in seconds — so this is what makes the value pseudonymous
# rather than personal data.
#
# Leave it unset and visitor hashing plus per-visitor rate limiting are disabled
# (the site still works; the numbers are just coarser).
#
# Generate:  openssl rand -base64 48
#
# Rotating it resets unique-visitor attribution. That is the intended trade-off
# for a periodic rotation.

# ANALYTICS_SALT=

# -----------------------------------------------------------------------------
# Revalidation secret (optional)
# -----------------------------------------------------------------------------
# Shared secret for POST /api/revalidate, which purges the content cache after
# an edit in Supabase. Unset means the endpoint is disabled, not open.
#
# Generate:  openssl rand -base64 48
#
# Send it as the `x-revalidate-secret` header. Wiring instructions for the
# Supabase Database Webhook are in supabase/README.md.

# REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# HackTheBox live stats (optional)
# -----------------------------------------------------------------------------
# The HackTheBox section appears once HACKTHEBOX.profileId is set in
# packages/config/src/site.ts. Without a token it shows the static fallback
# values from that file; with one it shows live rank, points and owns,
# refreshed every six hours.
#
# HackTheBox -> Profile Settings -> App Tokens. Server-only; never NEXT_PUBLIC_.
# HTB_APP_TOKEN=
